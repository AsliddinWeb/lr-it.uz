# Serverda: cp .env.production.example .env  va qiymatlarni to'ldiring.
# Parollarni yaratish:  openssl rand -hex 24

ENVIRONMENT=production

# --- Ma'lumotlar bazasi (POSTGRES_PASSWORD va DATABASE_URL ichidagi parol bir xil bo'lsin) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://edtech:BU_YERGA_POSTGRES_PAROLI@postgres:5432/edtech
REDIS_URL=redis://redis:6379/0

# --- Xavfsizlik: openssl rand -hex 32 ---
JWT_SECRET=

# --- Domenlar ---
PUBLIC_BASE_URL=https://lr-it.uz
CORS_ORIGINS=["https://lr-it.uz","https://www.lr-it.uz","https://lr-it.neonsoft.uz"]


# --- Kod ijrosi ---
PISTON_URL=http://piston:2000

# --- AI yordamchi (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Email (tasdiqlash kodi, parolni tiklash) ---
# Busiz email orqali ro'yxatdan o'tish ishlamaydi (Google orqali kirish esa ishlayveradi).
# Sozlagach tekshiring: docker compose exec backend python -m app.scripts.send_test_email siz@gmail.com
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=manzil@gmail.com, SMTP_PASSWORD=<16 belgili "App password">,
#        SMTP_FROM manzili SMTP_USER bilan bir xil bo'lsin. Port 465 bo'lsa, SSL avtomatik yoqiladi.
# Yaxshiroq yetkazish uchun: Brevo / Resend / Mailgun SMTP + o'z domeningiz (SPF va DKIM bilan).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EdTech <no-reply@lr-it.uz>

# --- Google bilan kirish (Google Cloud Console → OAuth client ID, "Web application") ---
# DEPLOY.md'dagi "Google bilan kirish" bo'limiga qarang. Bo'sh bo'lsa, Google tugmasi ko'rinmaydi.
GOOGLE_CLIENT_ID=

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api/v1

# --- Docker Compose: serverda `docker compose ...` o'zi production faylini ishlatadi ---
COMPOSE_FILE=docker-compose.prod.yml
