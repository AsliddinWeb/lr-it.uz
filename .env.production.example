# Serverda: cp .env.production.example .env  va qiymatlarni to'ldiring.
# Parollarni yaratish:  openssl rand -hex 24

ENVIRONMENT=production

# --- Ma'lumotlar bazasi (POSTGRES_PASSWORD va DATABASE_URL ichidagi parol bir xil bo'lsin) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://edtech:BU_YERGA_POSTGRES_PAROLI@postgres:5432/edtech
REDIS_URL=redis://redis:6379/0

# --- Xavfsizlik: openssl rand -hex 32 ---
JWT_SECRET=

# --- Domenlar ---
PUBLIC_BASE_URL=https://lr-it.uz
CORS_ORIGINS=["https://lr-it.uz","https://www.lr-it.uz","https://lr-it.neonsoft.uz"]

# --- MinIO (fayllar, sertifikat PDF'lari) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Kod ijrosi ---
PISTON_URL=http://piston:2000

# --- AI yordamchi (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Email (OTP tasdiqlash, parolni tiklash) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LR IT <no-reply@lr-it.uz>

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api/v1

# --- Docker Compose: serverda `docker compose ...` o'zi production faylini ishlatadi ---
COMPOSE_FILE=docker-compose.prod.yml
